.guide-art { height: 330rpx; background: #e6eddc; border-radius: 30rpx; overflow: hidden; position: relative; }
.guide-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(116,144,90,.09) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(116,144,90,.09) 1rpx,transparent 1rpx); background-size: 44rpx 44rpx; }
.guide-river { position: absolute; height: 540rpx; width: 100rpx; border-radius: 50%; transform: rotate(42deg); background: #b8d2c8; left: 340rpx; top: -150rpx; }
.grove { position: absolute; background: #c6d6af; width: 145rpx; height: 130rpx; border-radius: 45% 60% 35% 55%; }
.grove-a { right: -20rpx; top: 20rpx; }
.grove-b { left: -55rpx; bottom: -60rpx; width: 240rpx; height: 180rpx; }
.guide-label { position: absolute; left: 26rpx; bottom: 26rpx; background: rgba(250,252,242,.87); border-radius: 18rpx; padding: 18rpx; }
.guide-label view { font-size: 28rpx; font-weight: 500; margin-top: 8rpx; }
.guide-label > text:last-child { font-size: 20rpx; color: #72816b; }
.filters { white-space: nowrap; margin-bottom: 24rpx; }
.filter { display: inline-block; padding: 12rpx 24rpx; border-radius: 99rpx; font-size: 25rpx; color: #71816a; background: #e9eedf; margin-right: 14rpx; }
.filter.active { background: #315f43; color: #fffefa; }
.location-number { font-size: 38rpx; font-weight: 300; color: #9caa8b; margin-right: 24rpx; }
.location-card .copy { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.location-meta { display: flex; align-items: center; margin-top: 20rpx; }
.location-meta > text { margin-left: 14rpx; font-size: 20rpx; }
