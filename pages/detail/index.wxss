.detail-copy { margin: 0; font-size: 28rpx; line-height: 1.9; color: #596c54; }
.article { display: block; white-space: pre-wrap; line-height: 2; font-size: 29rpx; color: #40543d; }
.route-stop { margin-top: 18rpx; display: flex; align-items: center; background: #fffefa; padding: 24rpx; border-radius: 22rpx; }
.stop-index { border-radius: 50%; height: 56rpx; width: 56rpx; background: #e9eeda; text-align: center; line-height: 56rpx; margin-right: 22rpx; color: #729452; }
.observation { background: #fffefa; padding: 20rpx 24rpx; border-bottom: 1rpx solid #eff2e6; }
.observation-value { font-size: 32rpx; color: #426643; }
