.upload-panel { height: 460rpx; border: 2rpx dashed #b6c7a1; border-radius: 30rpx; background: #edf2e4; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; overflow: hidden; }
.upload-panel .copy { font-size: 21rpx; }
.scan-frame { width: 145rpx; height: 145rpx; border: 2rpx solid #c3d1ad; border-radius: 28rpx; position: relative; margin-bottom: 35rpx; overflow: hidden; }
.wave { position: absolute; left: 12rpx; right: 12rpx; height: 10rpx; border-radius: 99rpx; background: #7ba7c9; opacity: .8; }
.wave.one { bottom: 30rpx; }
.wave.two { bottom: 60rpx; opacity: .55; }
.wave.three { bottom: 90rpx; opacity: .3; }
.preview { width: 100%; height: 100%; }
.replace { position: absolute; bottom: 20rpx; background: rgba(37,65,37,.65); color: white; border-radius: 99rpx; padding: 7rpx 20rpx; font-size: 23rpx; }
.upload-consent { margin-top: 28rpx; font-size: 23rpx; color: #607751; }
.upload-consent label { display: flex; align-items: center; }
.upload-consent checkbox { transform: scale(.75); margin-left: -8rpx; }
.privacy-link { color: #376f4a; margin-left: 10rpx; }
.scope-card { padding: 26rpx; background: #edf1e2; border-radius: 24rpx; }
.scope-labels { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.scope-labels text { background: #fffefa; color: #698552; padding: 5rpx 15rpx; border-radius: 99rpx; font-size: 21rpx; margin: 8rpx 10rpx 0 0; }
.location-card { padding: 26rpx; background: #e7efe6; border-radius: 24rpx; }
.location-card .copy { margin-top: 10rpx; }
