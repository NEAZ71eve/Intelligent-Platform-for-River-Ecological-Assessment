# Replace the domain, certificate paths and /srv/hyhq before installing.
# This example has NOT been applied to the Seoul server.
server {
    listen 80;
    server_name api.example.xyz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.example.xyz;
    ssl_certificate /etc/letsencrypt/live/api.example.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.xyz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;

    location /static/ {
        alias /srv/hyhq/backend/staticfiles/;
        access_log off;
        expires 1d;
    }

    # Uploaded images must use ownership-checked API endpoints. No media alias.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }
}
