# Template only. Replace each CHANGE_ME value before use.
# Keep the live file outside Git and readable only by its service owner.
ENV=production
LLM_ENABLED=0
DEEPSEEK_API_KEY=
# Real weather: fill only in a protected server environment file, never in Git.
QWEATHER_ENABLED=0
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# Fixed deployment allocation: Beijing 29900 + local 100 <= 30000.
QWEATHER_MONTHLY_LIMIT=29900
QWEATHER_WEATHER_TTL_SECONDS=1800
QWEATHER_AIR_TTL_SECONDS=3600
QWEATHER_ALERT_TTL_SECONDS=900
DEEPSEEK_MODEL=deepseek-flash
LLM_DAILY_TURN_LIMIT=5
DJANGO_DEBUG=0
ALLOW_DEV_AUTH=0
HYHQ_USE_SQLITE=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.xyz
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.xyz
DATABASE_URL=postgresql://hyhq:CHANGE_ME@127.0.0.1:5432/hyhq
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Set only when using a trusted reverse proxy like the supplied Nginx template.
TRUST_PROXY_HTTPS=1
HYHQ_MODEL_ROOT=/srv/hyhq/inference/artifacts
HYHQ_RECOGNITION_TIMEOUT_SECONDS=10
HYHQ_ASSESSMENT_MODEL_ROOT=/srv/hyhq/inference/artifacts
HYHQ_ASSESSMENT_TIMEOUT_SECONDS=10
