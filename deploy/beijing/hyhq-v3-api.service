[Unit]
Description=HYHQ Django API and administrator site
After=network.target postgresql.service

[Service]
Type=simple
User=hyhq
Group=hyhq
WorkingDirectory=/srv/hyhq-releases/f31c55f/backend
EnvironmentFile=/etc/hyhq/f31c55f.env
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/hyhq-releases/f31c55f/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18080 --workers 1 --threads 1 --timeout 30 --access-logfile -
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/hyhq-releases/f31c55f/backend/var

[Install]
WantedBy=multi-user.target
