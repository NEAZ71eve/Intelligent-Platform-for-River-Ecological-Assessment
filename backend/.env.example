# Copy to backend/.env for LOCAL development only. Environment variables override this file.
ENV=development
DJANGO_DEBUG=1
ALLOW_DEV_AUTH=1
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=postgresql://hyhq:hyhq-dev-only@127.0.0.1:5432/hyhq
# Explicit development fallback; PostgreSQL remains the primary database.
HYHQ_USE_SQLITE=0
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TRUST_PROXY_HTTPS=0

