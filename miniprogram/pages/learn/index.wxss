.editorial-card { position: relative; overflow: hidden; display: flex; padding: 30rpx 24rpx; background: #ebeeda; border-radius: 24rpx; }
.editorial-number { font-size: 32rpx; color: #91a075; margin-right: 22rpx; }
.editorial-card .title { margin-top: 12rpx; }
.paper-leaf { position: absolute; right: -22rpx; bottom: -20rpx; width: 125rpx; height: 195rpx; background: #d1dcbb; border-radius: 90% 0 90% 0; transform: rotate(-15deg); }
.tabs { display: flex; border-bottom: 1rpx solid #e1e7d9; margin-bottom: 24rpx; }
.tab { margin-right: 40rpx; padding: 12rpx 4rpx 18rpx; color: #8a937f; font-size: 29rpx; }
.tab.selected { color: #2b6547; font-weight: 600; border-bottom: 4rpx solid #427450; }
.tags { margin-top: 18rpx; color: #8a967b; font-size: 22rpx; }
.tags text { margin-right: 18rpx; }
