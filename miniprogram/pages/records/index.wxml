<view class="page"><text class="eyebrow">COLLECTION / 绿色记忆</text><view class="page-title">{{title}}</view><view class="subtitle">这些记录仅向当前账号展示。</view><view class="section"><page-state loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !records.length}}" empty-text="去探索一下，把喜欢的绿色留在这里。" bindretry="load" /></view><block wx:if="{{!loading}}"><view class="card" wx:for="{{records}}" wx:key="id"><view data-id="{{item.id}}" bindtap="open"><view class="row"><text class="title">{{item.title}}</text><text class="chevron">›</text></view><view class="copy" wx:if="{{kind === 'recognition-jobs'}}">{{item.result_view ? item.result_view.heading : item.status_label}}<text wx:if="{{item.error_label}}"> · {{item.error_label}}</text></view><view class="small muted gap">{{item.created_label}}</view></view><view class="record-action"><button class="text-button" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">删除记录</button></view></view><button class="secondary gap" wx:if="{{next}}" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="more">加载更多</button></block><view wx:if="{{kind === 'visits'}}" class="notice">游览记录由用户自行添加，不代表定位核验的真实到访。</view></view>
