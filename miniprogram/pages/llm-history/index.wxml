<view class="page">
  <text class="eyebrow">AI JOURNAL / 我的对话</text><view class="page-title">把问题，接着问。</view><view class="subtitle">保存探索中的问题，也记录新的发现。</view>
  <view class="notice">从识别结果、生态导览或科普智游进入，继续围绕相关资料对话。</view>

  <view wx:if="{{status && !status.enabled}}" class="notice"><view class="title">AI 解读暂未开放</view><view class="copy">当前不能发送新问题，已有会话仍可查看。</view></view><view wx:if="{{statusError}}" class="error-inline">服务状态暂不可用：{{statusError}}</view>
  <view wx:if="{{!loggedIn && !loading}}" class="card section"><view class="title">登录后查看本人会话</view><button class="primary gap" bindtap="login">去登录</button></view>
  <page-state loading="{{loading}}" error="{{error}}" empty="{{loggedIn && !loading && !error && !sessions.length}}" empty-text="还没有 AI 对话，可从识别结果、导览或科普资料开启。" bindretry="load" />
  <block wx:if="{{loggedIn && !loading}}"><view wx:for="{{sessions}}" wx:key="id" class="card session-card"><view data-id="{{item.id}}" bindtap="open"><text class="pill">{{item.kind_label}}</text><view class="title gap">{{item.title}}</view><view class="small muted gap">创建于 {{item.created_label}}</view><view class="small muted">保留至 {{item.expires_label}}</view><view wx:if="{{item.is_recognition}}" class="small muted gap">{{item.include_image ? (item.image_available ? '已选择附图解读' : '原图已不可用，后续仅解读文字结果') : '仅文字结果解读'}}</view></view><button class="text-button delete-link" data-id="{{item.id}}" disabled="{{busy}}" bindtap="remove">删除会话</button></view><view wx:if="{{moreError}}" class="error-inline">{{moreError}}</view><button wx:if="{{next}}" class="secondary gap" loading="{{loadingMore}}" disabled="{{loadingMore || busy}}" bindtap="more">加载更多会话</button></block>
</view>
