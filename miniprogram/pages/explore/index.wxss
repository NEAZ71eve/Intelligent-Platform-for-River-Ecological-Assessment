.region-picker { padding: 20rpx 26rpx; border-radius: 22rpx; background: #fffefa; }
.map-picker { font-size: 23rpx; color: #637759; margin: 16rpx 0; }
.map-picker > text:last-child { margin-left: 18rpx; white-space: nowrap; }
.map-frame { position: relative; overflow: hidden; border-radius: 26rpx; background: #e6eddc; }
.map-viewport { overflow: hidden; }
.map-content { position: relative; }
.map-image { display: block; position: absolute; left: 0; top: 0; }
.map-marker { position: absolute; width: 42rpx; height: 42rpx; border-radius: 50%; transform: translate(-50%, -50%); background: #456e49; border: 3rpx solid #fffefa; color: #fffefa; box-shadow: 0 3rpx 9rpx rgba(37, 67, 38, .22); display: flex; align-items: center; justify-content: center; z-index: 1; }
.map-marker text { font-size: 20rpx; font-weight: 600; line-height: 1; }
.marker-river, .marker-lake { background: #30758b; }
.marker-waste { background: #957047; }
.map-marker.selected { background: #b66439; box-shadow: 0 0 0 6rpx rgba(182, 100, 57, .25); z-index: 2; }
.map-loading { position: absolute; top: 0; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: center; color: #617953; background: rgba(233, 239, 220, .8); font-size: 25rpx; }
.map-toolbar { padding-top: 18rpx; flex-wrap: wrap; }
.zoom-buttons { display: flex; margin: 8rpx 0 8rpx auto; }
.zoom-buttons button { display: inline-flex; align-items: center; justify-content: center; width: 68rpx; height: 58rpx; line-height: 1; padding: 0; margin-left: 8rpx; color: #315f43; background: #e4ebd8; border-radius: 14rpx; font-size: 30rpx; }
.zoom-buttons .reset { width: 94rpx; font-size: 24rpx; }
.map-help, .map-credit { font-size: 21rpx; color: #78846d; line-height: 1.7; margin-top: 12rpx; }
.map-credit text { display: block; }
.selected-card { margin-top: 18rpx; border: 2rpx solid #d3dfc3; }
.selected-number { font-size: 38rpx; font-weight: 600; color: #b66439; margin-right: 24rpx; }
.filters { white-space: nowrap; margin-bottom: 24rpx; }
.filter { display: inline-block; padding: 12rpx 24rpx; border-radius: 99rpx; font-size: 25rpx; color: #71816a; background: #e9eedf; margin-right: 14rpx; }
.filter.active { background: #315f43; color: #fffefa; }
.location-number { font-size: 38rpx; font-weight: 300; color: #9caa8b; margin-right: 24rpx; }
.location-card .copy { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.location-meta { display: flex; align-items: center; margin-top: 20rpx; }
.location-meta > text + text { margin-left: 14rpx; font-size: 20rpx; }
