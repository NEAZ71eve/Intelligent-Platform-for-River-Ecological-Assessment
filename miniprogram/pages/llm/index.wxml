<view class="page ai-page">
  <view class="ai-heading"><view><text class="eyebrow">HYHQ / {{scopeLabel}}</text><view class="page-title">与山水对话</view></view><view class="model-badge"><text class="model-spark">✦</text><view><text class="model-name">{{modelLabel}}</text><text class="model-caption">AI 助手</text></view></view></view>
  <view class="subtitle">从眼前的发现，聊到更远的知识。</view>
  <view wx:if="{{status && !status.enabled}}" class="notice"><view class="title">AI 暂未开放</view><view class="copy">当前不能发送新问题，已有对话仍可查看。</view></view>
  <page-state loading="{{loading}}" error="{{error}}" bindretry="load" />
  <view wx:if="{{!loading && !loggedIn}}" class="card section"><view class="title">登录，继续你的探索</view><view class="copy">登录后可开启对话，并在个人中心查看记录。</view><button class="primary gap" bindtap="login">去登录</button></view>
  <block wx:if="{{!loading && loggedIn && !unavailable}}">
    <view wx:if="{{source && !session}}" class="card section source-card">
      <text class="pill">{{isRecognition ? '本次识别' : source.label}}</text>
      <view class="title gap">{{isRecognition ? (source.result_view.heading || '查看原任务结果') : source.title}}</view>
      <view class="copy source-summary">{{isRecognition ? source.result_view.explanation : source.summary}}</view>
      <button class="text-button gap" bindtap="original">{{isRecognition ? '查看原识别结果' : '查看相关资料'}}</button>
      <view wx:if="{{isRecognition}}" class="image-choice"><view class="grow"><view class="title">附上图片</view><view class="small muted">默认只分享识别结果；开启后由 DeepSeek 一起查看原图。</view></view><switch checked="{{includeImage}}" disabled="{{busy || !status.enabled}}" bindchange="imageChange" color="#3c725d" /></view>
      <button class="primary gap" loading="{{busy}}" disabled="{{busy || !status.enabled}}" bindtap="createSession">开启对话</button>
      <view class="small muted gap">AI 只会在你点击发送后回答。</view>
    </view>
    <block wx:if="{{session}}">
      <view class="card section source-card"><text class="pill">{{session.kind_label}}</text><view class="title gap">{{session.is_recognition ? session.title : (source ? source.title : (sourceLoading ? '正在加载相关资料…' : '相关资料暂不可用'))}}</view><text wx:if="{{session.is_recognition || source}}" class="context-preview gap" selectable>{{session.is_recognition ? session.context_text : source.summary}}</text><view wx:if="{{sourceError}}" class="error-inline">{{sourceError}}<button class="text-button gap" bindtap="load" disabled="{{busy}}">重新加载资料</button></view><button class="text-button gap" bindtap="original">{{session.is_recognition ? '查看原识别结果' : '查看相关资料'}}</button><view wx:if="{{session.is_recognition}}" class="small muted gap">{{session.include_image ? (session.image_available ? '已选择附图，发送时检查原图是否有效。' : '原图已不可用，后续仅分享文字结果与对话。') : '仅分享文字结果与对话，不附送图片。'}}</view></view>
      <view class="card section composer"><view class="title">有什么想了解的？</view><textarea class="question" value="{{question}}" maxlength="500" disabled="{{busy || hasPending || !status.enabled}}" bindinput="inputQuestion" /><view class="composer-footer"><text class="small muted">{{questionCount}} / 500</text><button class="primary send-button" loading="{{busy}}" disabled="{{busy || hasPending || !status.enabled}}" bindtap="send">发送</button></view><view wx:if="{{hasPending}}" class="small muted gap">正在回答，完成后可继续提问。</view></view>
      <view class="section-head section"><text class="section-title">对话记录</text><button class="text-button" bindtap="load" disabled="{{busy}}">刷新</button></view>
      <view class="notice" wx:if="{{!turns.length && !moreError}}">还没有发送问题。</view>
      <view wx:for="{{turns}}" wx:key="id" class="card turn"><view class="small muted">我 · {{item.created_label}}</view><text class="question-text gap" selectable>{{item.question}}</text><view class="divider"></view><view class="answer-heading"><text class="answer-mark">✦</text><text class="answer-model">{{item.model_label}}</text><text class="small muted">{{item.status_label}}</text></view><view wx:if="{{item.status === 'succeeded'}}" class="answer gap"><markdown-view content="{{item.answer || '本轮未提供可展示的文本。'}}" /></view><view wx:elif="{{item.status === 'failed'}}" class="error-inline">{{item.message || '本轮未完成，可稍后重新发送。'}}</view><view wx:else class="copy">问题已提交，正在准备回答。离开页面会停止自动查询。</view><view wx:if="{{isRecognition}}" class="small muted gap">{{item.image_label}}</view></view>
      <view wx:if="{{pollNotice}}" class="notice">{{pollNotice}}</view><button wx:if="{{polling}}" class="secondary gap" bindtap="pausePolling">停止自动刷新</button><button wx:elif="{{hasPending}}" class="secondary gap" bindtap="resumePolling" disabled="{{busy}}">恢复状态查询</button>
      <view wx:if="{{moreError}}" class="error-inline">{{moreError}}</view><button wx:if="{{next}}" class="secondary gap" bindtap="more" loading="{{loadingMore}}" disabled="{{loadingMore || busy}}">加载更早的对话</button>
    </block>
  </block>
  <view wx:if="{{actionError}}" class="error-inline">{{actionError}}</view>
  <view class="ai-footnote">{{disclaimer}}</view><button class="text-button privacy-link" bindtap="privacy">隐私说明</button><button wx:if="{{loggedIn}}" class="secondary section" bindtap="history">我的 AI 对话</button>
</view>
