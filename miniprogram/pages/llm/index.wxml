<view class="page">
  <text class="eyebrow">AI NOTES / 一起核对</text><view class="page-title">读一读这次发现</view>
  <view class="subtitle">基于已有识别结果的 DeepSeek 辅助解读</view>
  <view class="notice">{{disclaimer}}</view>
  <view wx:if="{{status}}" class="card section"><view class="title">{{status.enabled ? 'DeepSeek 解读服务' : 'AI 解读暂未开放'}}</view><view class="copy">{{status.notice || (status.enabled ? '每次点击发送都会占用当前账号当天的可用轮次。' : '服务端尚未启用此功能，请稍后再试。')}}</view><view wx:if="{{quota}}" class="quota"><text class="quota-number">{{quota.remaining}}</text><text> / {{quota.limit}} 轮可用</text><view class="small muted gap">当前账号全部会话合计 · 已用 {{quota.used}} · 处理中 {{quota.reserved}}</view><view class="small muted">额度日期 {{quota.date}} · 重置 {{quota.reset_label}}</view></view><view wx:elif="{{loggedIn}}" class="small muted gap">额度暂不可用，确认后才能发送。</view></view>
  <page-state loading="{{loading}}" error="{{error}}" bindretry="load" />
  <view wx:if="{{!loading && !loggedIn}}" class="card section"><view class="title">登录后查看自己的解读</view><button class="primary gap" bindtap="login">去登录</button></view>
  <block wx:if="{{!loading && loggedIn && !unavailable}}">
    <view wx:if="{{source && !session}}" class="card section"><text class="pill">原识别结果</text><view class="title gap">{{source.result_view.heading || '查看原任务结果'}}</view><view class="copy">{{source.result_view.explanation}}</view><button class="text-button gap" bindtap="original">查看完整原结果</button><view class="divider"></view><view class="row"><view class="grow"><view class="title">另外附送原图</view><view class="small muted">默认不发图片；原图不可用时会提示，不改用缩略图。</view></view><switch checked="{{includeImage}}" disabled="{{busy || !status.enabled}}" bindchange="imageChange" color="#527b48" /></view><checkbox-group class="consent gap" bindchange="consentChange"><label><checkbox value="agree" checked="{{consent}}" disabled="{{busy || !status.enabled}}" color="#527b48" />我同意将本次识别结果、相关公开科普资料、主动发送的问题和本会话上下文交给 DeepSeek 处理<text wx:if="{{includeImage}}">，并另外附送原图</text>。</label></checkbox-group><button class="text-button" bindtap="privacy">查看隐私说明</button><button class="primary gap" loading="{{busy}}" disabled="{{busy || !consent || !status.enabled}}" bindtap="createSession">确认并建立解读会话</button><view class="small muted gap">建立会话后仍需点击发送；首次解读也计入每日额度。</view></view>
    <block wx:if="{{session}}">
      <view class="card section"><text class="pill">{{session.kind_label}} · 原模型摘要</text><view class="title gap">{{session.title}}</view><text class="answer gap" selectable>{{session.context_text}}</text><button class="text-button gap" bindtap="original">查看完整原识别结果</button><view class="small muted gap">保留至 {{session.expires_label}}</view><view class="small muted">{{session.include_image ? (session.image_available ? '已同意附图；发送时由服务端检查原图是否仍有效。' : '原图已不可用，之后的解读仅发送文字结果和对话。') : '仅发送文字结果和对话，不附送图片。'}}</view></view>
      <view class="card section"><view class="title">向 DeepSeek 提问</view><textarea class="question" value="{{question}}" maxlength="500" disabled="{{busy || hasPending || !status.enabled}}" placeholder="请围绕本次结果提问，勿填写身份信息或其他敏感内容。" bindinput="inputQuestion" /><view class="small muted question-count">{{questionCount}} / 500 字</view><button class="primary gap" loading="{{busy}}" disabled="{{busy || hasPending || !status.enabled || !quota || quota.remaining === 0}}" bindtap="send">发送问题 · 使用 1 轮额度</button><view wx:if="{{hasPending}}" class="small muted gap">本会话仍有轮次处理中，完成后可继续提问。</view></view>
      <view class="section-head section"><text class="section-title">AI 对话 · 最新在前</text><button class="text-button" bindtap="load" disabled="{{busy}}">刷新</button></view>
      <view class="notice" wx:if="{{!turns.length && !moreError}}">尚未发送问题。上方预填的文字不会自动发送。</view>
      <view wx:for="{{turns}}" wx:key="id" class="card turn"><view class="small muted">我的问题 · {{item.created_label}}</view><text class="question-text gap" selectable>{{item.question}}</text><view class="divider"></view><view class="row"><text class="pill">DeepSeek · {{item.status_label}}</text><text class="small muted">{{item.model}}</text></view><text wx:if="{{item.status === 'succeeded'}}" class="answer gap" selectable>{{item.answer || '本轮未提供可展示的文本。'}}</text><view wx:elif="{{item.status === 'failed'}}" class="error-inline">{{item.message || '本轮解读未完成，请查看额度后再发送。'}}</view><view wx:else class="copy">问题已提交，等待服务端处理。离开页面会停止自动查询。</view><view class="small muted gap">{{item.image_label}}</view></view>
      <view wx:if="{{pollNotice}}" class="notice">{{pollNotice}}</view><button wx:if="{{polling}}" class="secondary gap" bindtap="pausePolling">停止自动刷新</button><button wx:elif="{{hasPending}}" class="secondary gap" bindtap="resumePolling" disabled="{{busy}}">恢复状态查询</button>
      <view wx:if="{{moreError}}" class="error-inline">{{moreError}}</view><button wx:if="{{next}}" class="secondary gap" bindtap="more" loading="{{loadingMore}}" disabled="{{loadingMore || busy}}">加载更早的轮次</button>
    </block>
  </block>
  <view wx:if="{{actionError}}" class="error-inline">{{actionError}}</view><button wx:if="{{loggedIn}}" class="secondary section" bindtap="history">查看我的 AI 解读会话</button>
</view>
