.brand { margin-bottom: 30rpx; }
.brand-identity { display: flex; align-items: center; min-width: 0; }
.brand-logo-card { flex-shrink: 0; width: 116rpx; height: 116rpx; padding: 6rpx; margin-right: 16rpx; border: 1rpx solid #d4e2cf; border-radius: 20rpx; background: #fff; }
.brand-logo { display: block; width: 100%; height: 100%; }
.brand .pill { flex-shrink: 0; margin-left: 12rpx; }
.page-title { margin-top: 0; }
.region-bar { padding: 0 2rpx; }
.weather-card { background: #315e42; border-radius: 30rpx; padding: 28rpx 30rpx; color: #fafbef; overflow: hidden; }
.weather-kicker { color: #d5e6c6; font-size: 25rpx; }
.weather-main { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.temperature { font-size: 100rpx; line-height: 1.2; font-weight: 300; }
.weather-detail { color: #d1e2c6; font-size: 25rpx; }
.weather-foot { border-top: 1rpx solid rgba(255,255,255,.15); padding-top: 18rpx; color: #bcd2b0; font-size: 20rpx; }
.sun-art { width: 230rpx; height: 178rpx; position: relative; overflow: hidden; border-radius: 0 0 12rpx 12rpx; }
.sun { width: 78rpx; height: 78rpx; position: absolute; top: 5rpx; right: 55rpx; border-radius: 50%; background: #e4d392; }
.hill { width: 240rpx; height: 160rpx; position: absolute; border-radius: 60% 60% 0 0; transform: rotate(-25deg); top: 95rpx; left: -25rpx; background: #86a16a; }
.hill.front { background: #b1c089; transform: rotate(30deg); left: 90rpx; top: 102rpx; }
.entry { display: flex; align-items: center; background: #fffefa; border: 1rpx solid #d4e2cf; border-radius: 24rpx; padding: 24rpx 22rpx; margin-top: 14rpx; }
.entry-icon { font-size: 46rpx; width: 76rpx; height: 80rpx; line-height: 80rpx; border-radius: 19rpx; text-align: center; margin-right: 22rpx; }
.water { background: #e1ede9; color: #608d84; }
.leaf { background: #ebefdf; color: #749349; }
.book { background: #f3ecdc; color: #aa9560; }
.entry .title { font-size: 29rpx; }
.entry .copy { font-size: 22rpx; margin-top: 3rpx; }
.city-section { padding: 26rpx; background: #fffefa; border: 1rpx solid #d4e2cf; border-radius: 28rpx; }
.city-choice { margin: 20rpx 0; }
.city-temperature { font-size: 76rpx; }
.city-section .sun-art { width: 155rpx; flex-shrink: 0; }
.air-card { padding: 22rpx; border-radius: 20rpx; background: #edf3e8; }
.aqi-row { display: flex; align-items: baseline; gap: 18rpx; margin: 12rpx 0; }
.aqi-value { font-size: 54rpx; color: #315e42; }
.pollutants { display: flex; flex-wrap: wrap; gap: 16rpx; }
.pollutant { min-width: 150rpx; font-size: 25rpx; }
.source-copy { margin-top: 12rpx; font-size: 20rpx; color: #687761; overflow-wrap: anywhere; white-space: pre-wrap; }
.source-link { margin-top: 22rpx; padding: 0; text-align: left; font-size: 22rpx; color: #315e42; background: transparent; line-height: 1.6; }
.source-link::after { border: 0; }
.warning-card { margin-top: 16rpx; padding: 20rpx; border: 1rpx solid #ddc9a1; border-radius: 16rpx; background: #fff8e9; }
.warning-body { margin: 16rpx 0; font-size: 25rpx; white-space: pre-wrap; }
