<view class="page">
  <page-state loading="{{loading}}" error="{{error}}" bindretry="load" />
  <block wx:if="{{!loading && !error && item}}">
    <text class="eyebrow">{{kind === 'place' ? 'PLACE / 生态地点' : kind === 'content' ? 'JOURNAL / 科普手记' : 'ROUTE / 绿色漫步'}}</text>
    <view class="page-title">{{item.name || item.title}}</view>
    <view class="row gap"><source-label source="manual" /><text class="pill" wx:if="{{item.is_demo}}">示范资料</text></view>
    <view class="card section"><view class="copy detail-copy">{{item.description || item.summary || '暂无简介'}}</view><block wx:if="{{kind === 'content'}}"><view class="divider"></view><text class="article" selectable>{{item.body}}</text><view class="small muted section">资料来源：{{item.source || '管理员整理'}}</view><view class="small muted">更新：{{item.updated_label}}</view></block><block wx:if="{{kind === 'place'}}"><view class="small muted gap">所属区域：{{item.region_name}}</view><view class="small muted">资料说明：{{item.source_note || '管理员维护的教学示范地点'}}</view></block></view>
    <view class="section" wx:if="{{kind === 'route'}}"><view class="section-title">沿途停留</view><view class="route-stop" wx:for="{{item.stops}}" wx:key="id" data-id="{{item.place.id}}" bindtap="openPlace"><view class="stop-index">{{item.order}}</view><view class="grow"><view class="title">{{item.place.name}}</view><view class="copy">{{item.note || item.place.description}}</view></view><text class="chevron">›</text></view><view class="notice">路线为管理员预设，不包含实时导航或到访核验。</view></view>
    <view class="section" wx:if="{{kind === 'place' && item.water_body_id}}"><button class="primary" bindtap="openWater">查看此水体的指标与趋势</button></view>
    <view class="actions" wx:if="{{kind !== 'route'}}"><button class="secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="toggleFavorite">{{favoriteId ? '取消收藏' : '收藏资料'}}</button><button wx:if="{{kind === 'place'}}" class="primary" disabled="{{busy}}" bindtap="visit">记录游览</button></view>
    <view class="error-inline" wx:if="{{recordError}}">个人记录同步失败：{{recordError}}</view>
    <view class="section" wx:if="{{stations.length || observationError}}"><view class="section-head"><text class="section-title">监测数据样例</text><source-label source="simulation" /></view><picker wx:if="{{stations.length}}" range="{{stations}}" range-key="name" value="{{stationIndex}}" bindchange="changeStation"><view class="card row"><text>{{stations[stationIndex].name}}</text><text class="chevron">⌄</text></view></picker><button wx:if="{{stations.length}}" class="secondary gap" bindtap="openDataCenter">在数据中心查看此站趋势</button><view class="gap"><page-state loading="{{observationLoading}}" error="{{observationError}}" empty="{{!observationLoading && !observationError && !observations.length}}" empty-text="该监测站暂无模拟观测。" bindretry="loadObservations" /></view><view class="observation" wx:for="{{observations}}" wx:key="id"><view class="row"><text>{{item.metric_name}}</text><text class="observation-value">{{item.value_label}} <text class="small muted">{{item.unit}}</text></text></view><view class="small muted">{{item.time_label}} · {{item.quality_label}}</view></view><view class="notice">展示单一模拟批次的部分观测样例。缺失值保留为空缺，不输出官方水质类别；完整窗口、来源与批次可在数据中心查看。</view></view>
  </block>
</view>
