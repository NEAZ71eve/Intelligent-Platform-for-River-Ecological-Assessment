.scope-card { padding: 26rpx; background: #edf1e2; border-radius: 24rpx; }
.upload-panel { min-height: 340rpx; padding: 32rpx; border: 2rpx dashed #a7c6be; border-radius: 28rpx; background: #e9f1ed; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.water-symbol { font-size: 100rpx; line-height: 1.2; color: #589287; margin-bottom: 20rpx; }
/* Only the widthFix image determines this container's height; captions live outside it. */
.image-wrap { position: relative; overflow: hidden; border-radius: 24rpx; line-height: 0; background: #e9f1ed; }
.preview { width: 100%; display: block; }
.box-layer { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.detection-box { position: absolute; border: 3rpx solid #f3b642; }
.box-label { position: absolute; top: 0; left: 0; background: #f3b642; color: #203a30; font-size: 21rpx; line-height: 1.4; padding: 0 6rpx; }
.water-picker { padding: 18rpx; margin-top: 16rpx; border-radius: 16rpx; background: #f0f4e9; }
.nearby { padding: 20rpx; border-radius: 16rpx; background: #edf4ed; }
.privacy-link { color: #376f4a; margin-left: 10rpx; }
.result-banner { padding: 32rpx; background: #e3eee6; border-radius: 28rpx; }
.rule-score { font-size: 72rpx; color: #306c51; font-weight: 650; }
.rule-score text { font-size: 25rpx; font-weight: 400; }
.detection-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #edf0e5; }
.grade-pill { display: inline-block; margin-top: 12rpx; background: #306c51; color: #ffffff; font-size: 26rpx; border-radius: 99rpx; padding: 6rpx 22rpx; }
