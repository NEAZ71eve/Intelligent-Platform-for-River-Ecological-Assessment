.profile-brand { display: flex; align-items: center; justify-content: space-between; }
.profile-brand-mark { width: 108rpx; height: 108rpx; padding: 6rpx; border: 1rpx solid #d4e2cf; border-radius: 18rpx; background: #fff; }
.brand-logo { display: block; width: 100%; height: 100%; }
.login-card { border: 1rpx solid #c8dbc4; }
.guest-mark { width: 176rpx; height: 176rpx; padding: 8rpx; margin: 6rpx auto 18rpx; border: 1rpx solid #d4e2cf; border-radius: 26rpx; background: #fff; }
.guest-title { text-align: center; font-size: 34rpx; font-weight: 600; }
.center { text-align: center; }
.login-notice { font-size: 22rpx; line-height: 1.9; text-align: center; margin: 28rpx 0 8rpx; color: #738168; }
.legal-link { color: #2e6b49; text-decoration: underline; }
.avatar-button { width: 100rpx; height: 100rpx; line-height: 100rpx; padding: 0; font-size: 44rpx; border-radius: 28rpx; margin-right: 24rpx; background: #e6eddb; color: #6b8958; }
.avatar { width: 100rpx; height: 100rpx; }
.record-grid { display: flex; flex-wrap: wrap; background: #fffefa; border-radius: 24rpx; padding: 10rpx; }
.record-grid > view { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; font-size: 22rpx; color: #68785d; }
.record-symbol { font-size: 43rpx; color: #64884d; margin-bottom: 7rpx; }
.setting-link { padding: 8rpx 0; }
