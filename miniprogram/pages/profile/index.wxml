<view class="page">
  <view class="profile-brand"><text class="eyebrow">MY GREEN LIFE / 我的</text><view wx:if="{{user}}" class="profile-brand-mark"><image class="brand-logo" src="/assets/brand/hyhq-logo.jpg" mode="aspectFit" aria-label="海晏河清智慧平台标志" /></view></view>
  <view class="page-title">留住每一份绿意。</view>
  <view class="subtitle">你的收藏、发现与校园足迹。</view>
  <page-state loading="{{loading}}" error="{{error && !busy ? error : ''}}" bindretry="load" />
  <view wx:if="{{!loading && !user}}" class="card section login-card">
    <view class="guest-mark"><image class="brand-logo" src="/assets/brand/hyhq-logo.jpg" mode="aspectFit" aria-label="海晏河清智慧平台标志" /></view><view class="guest-title">欢迎来到海晏河清</view><view class="copy center"><view>游客可以自由浏览。登录后，</view><view>保存收藏与记录，上传照片开展观察。</view></view>
    <view class="login-notice">继续注册或登录，即表示你已阅读并同意<text class="legal-link" data-kind="terms" bindtap="legal">《用户协议》</text>与<text class="legal-link" data-kind="privacy" bindtap="legal">《隐私说明》</text>。</view>
    <button class="primary gap" loading="{{busy}}" disabled="{{busy}}" data-mode="wechat" bindtap="login">微信登录</button>
    <button wx:if="{{devAvailable}}" class="secondary gap" loading="{{busy}}" disabled="{{busy}}" data-mode="dev" bindtap="login">开发模拟登录</button>
    <view class="small muted gap center" wx:if="{{devAvailable}}">开发账号仅供联调，不建立微信身份。</view>
  </view>
  <block wx:if="{{!loading && user}}">
    <view class="card section"><view class="row"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{busy}}"><image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" /><text wx:else>清</text></button><view class="grow"><view class="title">{{user.nickname || '绿色生活体验者'}}</view><view class="copy">点击头像主动设置</view><text wx:if="{{authMode === 'development'}}" class="pill">开发模拟账号</text></view></view><view wx:if="{{avatarNotice}}" class="small muted gap">{{avatarNotice}}</view><view class="field"><text class="field-label">昵称</text><input type="nickname" maxlength="32" value="{{nickname}}" bindinput="nicknameInput" placeholder="给自己一个名字" disabled="{{busy}}" /></view><button class="secondary gap" loading="{{busy}}" disabled="{{busy}}" bindtap="saveProfile">保存昵称</button></view>
    <view class="record-grid section"><view data-kind="favorites" bindtap="records"><text class="record-symbol">♡</text><text>我的收藏</text></view><view data-kind="histories" bindtap="records"><text class="record-symbol">◷</text><text>浏览记录</text></view><view data-kind="assessment-jobs" bindtap="records"><text class="record-symbol">≈</text><text>河道观察记录</text></view><view data-kind="visits" bindtap="records"><text class="record-symbol">⌖</text><text>游览记录</text></view></view>
    <view class="card section"><view class="row"><view class="grow"><view class="title">保存浏览记录</view><view class="copy">关闭后不再添加新的浏览记录</view></view><switch checked="{{user.record_history}}" disabled="{{busy}}" color="#527b48" bindchange="privacyChange" /></view><view class="divider"></view><view class="row setting-link" data-kind="privacy" bindtap="legal"><text>隐私说明</text><text class="chevron">›</text></view><view class="row setting-link" data-kind="terms" bindtap="legal"><text>用户协议</text><text class="chevron">›</text></view></view>
    <view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="logout">退出登录</button><button class="danger" disabled="{{busy}}" bindtap="deleteAccount">注销账号</button></view>
  </block>
  <view wx:if="{{!loading}}" class="card section"><view class="row setting-link" bindtap="feedback"><view class="grow"><view class="title">我的反馈</view><view class="copy">提交问题并查看处理进度</view></view><text class="chevron">›</text></view></view>
  <view wx:if="{{!loading}}" class="card section"><view class="row setting-link" bindtap="aiHistory"><view class="grow"><view class="title">我的 AI 对话</view><view class="copy">查看与 DeepSeek Flash 的生态问答与评估解读</view></view><text class="chevron">›</text></view></view>
  <view class="footer-note">每一条记录，都由你掌握</view>
</view>
