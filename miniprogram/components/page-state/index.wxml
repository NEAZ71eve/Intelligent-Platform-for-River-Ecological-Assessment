<view wx:if="{{loading}}" class="state"><view class="pulse"></view><text>正在连接生态服务…</text></view>
<view wx:elif="{{error}}" class="state"><text class="state-title">暂时没能加载</text><text>{{error}}</text><button class="state-retry" size="mini" bindtap="retry">重新尝试</button></view>
<view wx:elif="{{empty}}" class="state"><text class="state-title">这里还在生长</text><text>{{emptyText}}</text></view>
